			// init code
			15 00 02 B0 5D
			15 00 02 B1 72 // VCOM
			15 00 02 B2 82
			15 00 02 B3 80
			15 00 02 B5 42
			15 00 02 B7 85
			15 00 02 B8 20
			15 00 02 C1 78
			15 00 02 C2 78
			15 64 02 D0 88
